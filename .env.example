# npx convex dev creates .env.local for your own deployment.
# The isolated local deployment configured during development uses these ports:
CONVEX_DEPLOYMENT=anonymous:anonymous-agent
VITE_CONVEX_URL=http://127.0.0.1:33210
VITE_CONVEX_SITE_URL=http://127.0.0.1:33211

# Optional, comma-separated mesh bootstrap URLs.
VITE_PRIVATE_MESH_URLS=https://private-mesh.wasmer.app/mesh
